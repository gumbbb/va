# ===========================================
# Edge Orchestrator - Single .env file Template
# Copy this to .env and fill in your values
# ===========================================

# --- Orchestrator ---
ORCHESTRATOR_PORT=8000
AGENT_URLS=http://localhost:8001,http://localhost:8002,http://localhost:8003,http://localhost:8004,http://localhost:8005

# --- LLM (choose OpenAI or Local) ---
# Paste your OpenAI API key here if using OpenAI provider
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Local LLM configuration (llama.cpp / vLLm / etc.)
LLM_PORT=8082
LOCAL_LLM_URL=http://localhost:8082/v1
LOCAL_LLM_MODEL=qwen
LLM_MODEL_DIR=./models/
LLM_MODEL_FILE=Qwen3-4B-Q4_K_M.gguf

# --- Car Control Agent ---
CAR_CONTROL_PORT=8001
CAR_CONTROL_BASE_URL=http://car_control:8001
CAR_CONTROL_SOUNDS_DIR=./shared/car_control
CAR_SIMULATOR_CONNECTED=true
CAR_CONTROL_VERBOSE_RESPONSE=true

# --- Car Manual Agent ---
CAR_MANUAL_PORT=8002
CAR_MANUAL_BASE_URL=http://car_manual:8002
CAR_MANUAL_BRAND=toyota

# --- Navigation Agent ---
DEMO_LAT=10.7769
DEMO_LNG=106.7009
DEMO_ADDRESS=HoChiMinh
OVERPASS_INTERPRETER_URL=https://overpass-api.de/api/interpreter
NAVIGATION_BASE_URL=http://navigation:8003

# --- Infotainment Agent ---
INFOTAINMENT_BASE_URL=http://infotainment:8004
INFOTAINMENT_MEDIA_DIR=./shared/infotainment

# --- Cloud Agent (optional) ---
CLOUD_BASE_URL=http://cloud:8005
TAVILY_API_KEY=your_tavily_api_key_here

# --- User Preference Agent ---
USER_PREFERENCE_PORT=8006
USER_PREFERENCE_URL=http://user_preference:8006

# --- Reminder Agent ---
REMINDER_PORT=8007
REMINDER_URL=http://reminder:8007

# --- Telegram Agent ---
TELEGRAM_AGENT_PORT=8008
TELEGRAM_AGENT_URL=http://telegram:8008
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# --- Smart Home Agent ---
SMART_HOME_PORT=8009
SMART_HOME_URL=http://smart_home:8009

# --- Voice Processing ---
ORCHESTRATOR_URL=http://localhost:8000
TTS_CHUNK_COUNT=5

# --- System / Hardware ---
HF_HOME=./cache
SPEAKER_MAC_ADDRESS=84:D3:52:7A:19:16
SUDO_PWD=your_sudo_password_here